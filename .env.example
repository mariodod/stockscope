# Copy to .env and fill in. Never commit real keys.

# App
APP_ENV=dev
LOG_LEVEL=INFO
# Facts older than this many days are flagged as stale
STALE_AFTER_DAYS=90
# Daily quote history older than this is removed by --job prune
QUOTE_RETENTION_DAYS=1825
# Years of price history fetched by --job history
HISTORY_YEARS=5

# Database (SQLAlchemy URL). SQLite is the zero-friction default for local dev;
# use PostgreSQL in production, e.g. postgresql+psycopg://user:pass@host:5432/stockscope
DATABASE_URL=sqlite:///./stockscope.db

# Optional shared cache for multi-process deployments (install .[cache] first)
REDIS_URL=

# Required by docker compose for the local PostgreSQL container
POSTGRES_PASSWORD=

# Data providers
FMP_API_KEY=
# yfinance and SEC need no key, but SEC requires a descriptive User-Agent.
SEC_USER_AGENT=Stockscope research contact@example.com

# Refresh schedule (cron-like, APScheduler)
QUOTE_REFRESH_CRON=0 22 * * 1-5
FUNDAMENTALS_REFRESH_CRON=0 3 * * 0
UNIVERSE_REFRESH_CRON=0 4 * * 0
HISTORY_REFRESH_CRON=0 5 * * 0
DIVIDENDS_REFRESH_CRON=0 6 * * 0
FILINGS_REFRESH_CRON=0 7 * * *
PRUNE_CRON=0 8 1 * *
